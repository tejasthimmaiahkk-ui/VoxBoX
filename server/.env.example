# OpenRouter credential. Keep it in the server environment or the host's secret store only.
# It must never appear in Git, in Android source, in BuildConfig, or inside the APK.
OPENROUTER_API_KEY=replace_with_a_server_side_openrouter_key

# Shared token the Android build presents as `Authorization: Bearer <token>`.
# Live mode refuses to forward provider requests without this, so a deployed proxy is never an
# open relay. Generate one with: openssl rand -base64 32
# A token compiled into an APK is extractable, so it is paired with the limits below rather than
# treated as a real secret.
VOXBOX_CLIENT_TOKEN=replace_with_a_long_random_token

# Abuse limits. Both are in-memory and per instance; they reset on restart and do not coordinate
# across replicas.
VOXBOX_RATE_LIMIT_MAX=60
VOXBOX_RATE_LIMIT_WINDOW_MS=60000
# Hard ceiling on billable provider calls per UTC day. This counts requests, not currency.
VOXBOX_DAILY_REQUEST_BUDGET=1500

# Optional model overrides. Defaults were chosen by measuring candidates against this project's
# own contracts; see the model routing comment at the top of server.mjs before changing them.
# VOXBOX_TRANSCRIPTION_MODEL=google/gemini-3.1-flash-lite
# VOXBOX_VISION_MODEL=google/gemini-2.5-flash-lite
# VOXBOX_NOTE_MODEL=openai/gpt-oss-120b

# Deterministic, non-AI responses for every endpoint. No provider calls are made.
MOCK_AI=1

# Legacy alias still recognized by the current server; prefer MOCK_AI.
# MOCK_VISION=1

# Loopback for local development. A hosted deployment sets HOST=0.0.0.0 and takes PORT from the
# platform, and must be reached only over HTTPS.
HOST=127.0.0.1
PORT=8787
