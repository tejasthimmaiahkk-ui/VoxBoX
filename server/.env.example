# Revoke the key exposed during development and use only a rotated server-side key.
OPENAI_API_KEY=replace_with_a_rotated_server_side_key

# Deterministic, non-AI responses for every endpoint. No provider calls are made.
MOCK_AI=1

# Legacy alias still recognized by the current server; prefer MOCK_AI.
# MOCK_VISION=1

# Keep this loopback-only unless an authenticated HTTPS gateway is added.
HOST=127.0.0.1
PORT=8787
