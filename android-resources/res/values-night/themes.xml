<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.VoxBox" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/vb_blue</item>
        <item name="colorOnPrimary">@color/vb_on_accent_light</item>
        <item name="colorSecondary">@color/vb_blue</item>
        <item name="android:colorBackground">@color/vb_bg_dark</item>
        <item name="colorSurface">@color/vb_surface_dark</item>
        <item name="colorSurfaceVariant">@color/vb_surface_variant_dark</item>
        <item name="colorOnBackground">@color/vb_fg_dark</item>
        <item name="colorOnSurface">@color/vb_fg_dark</item>
        <item name="colorOnSurfaceVariant">@color/vb_fg2_dark</item>
        <item name="colorOutlineVariant">@color/vb_line_dark</item>
        <item name="colorError">@color/vb_red</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:windowActivityTransitions">true</item>
    </style>

    <style name="ThemeOverlay.VoxBox.Blue" parent="">
        <item name="colorPrimary">@color/vb_blue</item>
        <item name="colorOnPrimary">@color/vb_on_accent_light</item>
    </style>
    <style name="ThemeOverlay.VoxBox.Green" parent="">
        <item name="colorPrimary">@color/vb_green</item>
        <item name="colorOnPrimary">@color/vb_on_accent_light</item>
    </style>
    <style name="ThemeOverlay.VoxBox.Orange" parent="">
        <item name="colorPrimary">@color/vb_orange</item>
        <item name="colorOnPrimary">@color/vb_on_accent_dark</item>
    </style>
    <style name="ThemeOverlay.VoxBox.Red" parent="">
        <item name="colorPrimary">@color/vb_red</item>
        <item name="colorOnPrimary">@color/vb_on_accent_light</item>
    </style>

</resources>
